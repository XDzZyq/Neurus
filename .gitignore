# Build artifacts
build/
build-*/
# The product docs mirror the source tree; keep docs/build/ tracked even though
# build/ is a build-artifact ignore.
!docs/build/
out/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.sln.docstates
*.slnLaunch.user
*.cache

# Visual Studio
.vs/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb
*.pdb
*.ilk
*.iobj
*.ipdb

# CMake generated
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
*.cmake
!CMakePresets.json
!cmake/*.cmake

# Generated shader headers
generated/

# Qt
*.moc
moc_*.cpp
qrc_*.cpp
ui_*.h
*.qmlc
*.jsc

# IDE
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Package managers
vcpkg_installed/
conanbuild*/

# Runtime artifacts
*.log
imgui.ini

# Binary outputs
*.exe
*.dll
*.lib
*.exp
*.so
*.dylib
*.bin

# Results/output
result/
output/

# lib/ is the Neurus-Lib submodule (upstream sources + downloaded prebuilt
# libraries). The prebuilt/ download target is git-ignored inside Neurus-Lib
# itself — not here — so this path must stay un-ignored for submodule ops.

# Temp
tmp/
temp/

# Screen shots
screenshots/

# Plan drafts and metafiles
.omo/
.ocx/
.superpowers/
plans/
specs/
# Graphify knowledge graph
# Everything under graphify-out/ is generated from src/ by `make doc`, except
# post_rebuild_cleanup.py, which is hand-maintained source: it holds the noise
# filters and the community-labelling rules that turn the raw extraction into
# the curated graph, and it pins PYTHONHASHSEED so clustering is reproducible.
graphify-out/*
!graphify-out/post_rebuild_cleanup.py

# BEGIN oh-my-opencode-slim worktrees
.slim/worktrees/
.slim/worktrees.json
# END oh-my-opencode-slim worktrees

# Python bytecode
__pycache__/
*.pyc

# Claude Code
.claude

# MkDocs web documentation (see mkdocs.yml)
# The rendered site, the API reference mkdoxy generates from src/ into the docs
# tree, and the graphify structure graph are all build output; only the
# hand-written pages are tracked. Regenerate with `make doc`.
/site/
/docs/Neurus/
/docs/graphify.html
/.mkdoxy/
